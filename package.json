{
  "name": "app-lens",
  "version": "0.2.0",
  "private": true,
  "description": "Manifest-driven, interactive showcase of what an application does, powered by generated mock data.",
  "workspaces": [
    "packages/core",
    "packages/ui",
    "packages/embed",
    "apps/viewer",
    "apps/studio",
    "packages/cli"
  ],
  "scripts": {
    "dev": "npm run dev -w @app-lens/viewer",
    "dev:embed": "npm run dev -w @app-lens/embed",
    "dev:studio": "npm run dev -w @app-lens/studio",
    "build": "npm run build -w @app-lens/viewer && npm run build -w @app-lens/studio && npm run build -w @app-lens/embed && npm run build -w @app-lens/cli",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "app-lens": "node packages/cli/dist/cli.js",
    "e2e": "playwright test",
    "measure": "node scripts/measure.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "vite": "^6.4.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
